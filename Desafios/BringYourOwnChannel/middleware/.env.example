# Modelo do .env da ponte. Copie para .env e preencha (o .env não vai para o Git)

SF_LOGIN_URL=https://SEU-DOMINIO.my.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# Platform Event de saída configurado no Bring Your Own Channel
SF_TOPICO=/event/SeuEvento__e

# Porta da ponte (não usar 8081, que é a do Metro/Expo)
PORTA=3000
