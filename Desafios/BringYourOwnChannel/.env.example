# Modelo do .env do app. Copie para .env e preencha (o .env não vai para o Git)

# Salesforce
EXPO_PUBLIC_SF_URL=https://SEU-DOMINIO.my.salesforce.com
EXPO_PUBLIC_SF_SCRT_URL=https://SEU-DOMINIO.my.salesforce-scrt.com
EXPO_PUBLIC_SF_CLIENT_ID=
EXPO_PUBLIC_SF_CLIENT_SECRET=
EXPO_PUBLIC_SF_ORG_ID=
EXPO_PUBLIC_SF_AUTHORIZATION_CONTEXT=
EXPO_PUBLIC_SF_CHANNEL_ADDRESS_ID=

# Identificador do cliente no canal ("from" das mensagens)
EXPO_PUBLIC_CLIENTE=cliente-teste-003

# Ponte Pub/Sub (middleware). Use o IP do computador que roda a ponte
EXPO_PUBLIC_PONTE_URL=ws://IP-DO-SEU-PC:3000
